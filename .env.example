# 公开行情无需 API Key。复制为 .env 后可由程序读取，已有环境变量优先。
BTC_DB_PATH=data/btc.sqlite3
BTC_LOG_DIR=logs
BTC_LOG_LEVEL=INFO
# 官方公开行情专用入口；程序不会自动更换数据源或使用代理。
BTC_REST_URL=https://data-api.binance.vision
BTC_WS_URL=wss://data-stream.binance.vision:443
BTC_HISTORY_MINUTES=500
BTC_HTTP_TIMEOUT=10
BTC_WS_TIMEOUT=15
BTC_WS_IDLE_TIMEOUT=30
BTC_RECONCILE_SECONDS=60
BTC_MAX_RECONNECT_DELAY=60

# M2：采集间隔在 config/sources.toml 按来源独立设置。
BTC_INTEL_TIMEOUT=12
BTC_INTEL_RETRIES=2
BTC_INTEL_CONCURRENCY=4
BTC_INTEL_HN_THREADS=20
BTC_INTEL_HN_ITEMS=120
BTC_INTEL_HN_LOOKBACK_DAYS=30
BTC_INTEL_MIN_SAMPLES=20
# Reddit 仅预留名称，适配器当前禁用且不读取这些凭证；有凭证也需平台用途批准。
BTC_REDDIT_CLIENT_ID=
BTC_REDDIT_CLIENT_SECRET=
