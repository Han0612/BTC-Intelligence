# 公开行情无需 API Key。复制为 .env 后可由程序读取，已有环境变量优先。
BTC_DB_PATH=data/btc.sqlite3
BTC_LOG_DIR=logs
BTC_LOG_LEVEL=INFO
# 官方公开行情专用入口；程序不会自动更换数据源或使用代理。
BTC_REST_URL=https://data-api.binance.vision
BTC_WS_URL=wss://data-stream.binance.vision:443
BTC_HISTORY_MINUTES=500
BTC_HTTP_TIMEOUT=10
BTC_WS_TIMEOUT=15
BTC_WS_IDLE_TIMEOUT=30
BTC_RECONCILE_SECONDS=60
BTC_MAX_RECONNECT_DELAY=60
